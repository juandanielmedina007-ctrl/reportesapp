<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <EditText android:id="@+id/dniSearch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:hint="Buscar por DNI" android:inputType="number" android:maxLength="8" android:textSize="16sp" android:singleLine="true"/>
  <Button android:id="@+id/search" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Buscar"/>
 </LinearLayout>
 <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="48dp" android:text="Ver todos / Actualizar"/>
 <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="10dp" android:textStyle="bold" android:textColor="#153C32"/>
 <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone"/>
 <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:textColor="#70533A" android:visibility="gone"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/reports" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="8dp"/>
 <Button android:id="@+id/more" android:layout_width="match_parent" android:layout_height="52dp" android:text="Cargar 5 siguientes"/>
</LinearLayout>
