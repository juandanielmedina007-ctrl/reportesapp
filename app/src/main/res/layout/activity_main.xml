<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LIMPIEZA PÚBLICA · MEDINA GARCES" android:textSize="11sp" android:letterSpacing="0.12" android:textColor="#157A61"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reporta Limpio" android:textStyle="bold" android:textSize="30sp" android:textColor="#153C32" android:layout_marginTop="6dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Una ciudad más limpia empieza contigo." android:textSize="14sp" android:textColor="#587269" android:layout_marginBottom="16dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
  <Button android:id="@+id/listTab" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Reportes"/>
  <Button android:id="@+id/newTab" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="+ Nuevo"/>
 </LinearLayout>
 <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
 <TextView android:id="@+id/connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#65796F" android:textSize="10sp" android:paddingTop="8dp"/>
</LinearLayout>
